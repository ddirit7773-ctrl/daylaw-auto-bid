# Naver Search Ads API credentials
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CUSTOMER_ID=

# Cleaner rule
# - first 21 days after registration: never delete
# - recent 21 days must be 0 impressions / 0 clicks
# - full 90-day history must also be 0 / 0
RECENT_DAYS=21
MIN_KEYWORD_AGE_DAYS=21
HISTORY_DAYS=90

# Built-in core suffix library already covers the scam-template families used by
# the generator: stock/coin/futures, shopping/travel/movie/gift-card team
# missions, lotto/compensation/refund, romance scam, and common fraud intents.
# Values here only ADD more protection; they never remove the built-in list.
PROTECTED_SUFFIXES=

# Optional: comma-separated exact keyword whitelist.
# Example: EXTRA_PROTECTED_KEYWORDS=특별보호키워드1,특별보호키워드2
EXTRA_PROTECTED_KEYWORDS=

# Optional group-survivor reserve concepts used by build_safe_delete_plan.py
RESERVE_TOKENS=
MIN_SURVIVORS_PER_GROUP=20
MAX_DELETE_RATE_PER_GROUP=0.60

# API / storage
NAVER_BASE_URL=https://api.searchad.naver.com
STATS_BATCH_SIZE=100
BACKUP_DIR=data/backups
DELETE_LOG_PATH=logs/deleted_keywords.csv
