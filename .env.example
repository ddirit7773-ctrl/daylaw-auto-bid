# Naver Search Ads API credentials
NAVER_API_KEY=
NAVER_SECRET_KEY=
NAVER_CUSTOMER_ID=

# V2 safe-fast scan tuning
# 1 = fully sequential, 2~3 = faster, 4 = maximum allowed by the app.
# Default/recommended: 3. Read-only bulk stats only; final delete verification stays sequential.
DAYLAW_STATS_WORKERS=3

# Naver API endpoint
NAVER_BASE_URL=https://api.searchad.naver.com

# Protection files edited by the desktop app
# - config/protected_keywords.txt      : exact PERMANENT keywords
# - config/protected_suffixes.txt      : adgroup name + suffix -> PERMANENT
# - config/type_core_keywords.txt      : exact TYPE_CORE keywords
# - config/type_core_suffixes.txt      : adgroup name + suffix -> TYPE_CORE
PROTECTION_CONFIG_DIR=config

# V2 safety policy lives in config/cleaner_policy.json.
# Current policy controls registration protection, inactivity windows,
# click-protection window, 7-day recheck, account cleanup start/stop,
# and 20 -> 200 -> 500 deletion batch sizes.

# Legacy cleaner compatibility options (not used to weaken V2 protection)
PROTECTED_SUFFIXES=
EXTRA_PROTECTED_KEYWORDS=
BACKUP_DIR=data/backups
DELETE_LOG_PATH=logs/deleted_keywords.csv
